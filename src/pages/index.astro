---
import Blob from '../components/Blob.astro';
import Button from '../components/Button.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CTABanner from '../components/CTABanner.astro';
import GalleryCard from '../components/GalleryCard.astro';
import LocationCard from '../components/LocationCard.astro';
import Section from '../components/Section.astro';
import { categorias } from '../data/categorias';
import { galeria } from '../data/galeria';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';
import { createLocalBusinessJsonLd } from '../lib/seo';

const badges = ['🍃 Selección diaria', '🗓️ Producto de temporada', '🤝 Atención de mercado'];

const imagenFruta = galeria.find((item) => item.id === 'fruta-surtida')!;
const imagenVerdura = galeria.find((item) => item.id === 'verduras-frescas')!;
const imagenPuesto = galeria.find((item) => item.id === 'puesto-mercado')!;
const imagenPedidos = galeria.find((item) => item.id === 'preparacion-pedidos')!;
const imagenEquipo = galeria.find((item) => item.id === 'equipo-negocio')!;
---

<Layout
  title={negocio.seo.defaultTitle}
  description={negocio.seo.defaultDescription}
  canonical="/"
  jsonLd={createLocalBusinessJsonLd()}
>
  <section class="relative overflow-hidden px-5 pt-8 pb-10 sm:pt-16 sm:pb-24">
    <Blob class="-top-24 -left-20 h-72 w-72 bg-berry/20" />
    <Blob class="top-16 -right-24 h-80 w-80 bg-leaf/15" />
    <Blob class="bottom-0 left-1/3 h-56 w-56 bg-lilac-deep/15" />

    <div class="relative mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-12">
      <div>
        <p class="m-0 inline-block rounded-full border border-line bg-white/70 px-4 py-1.5 text-sm font-bold text-leaf backdrop-blur">
          Mercado de Abastos Tiro de Línea · Sevilla
        </p>
        <h1 class="m-0 mt-4 text-3xl font-black leading-[1.1] text-ink sm:mt-5 sm:text-5xl sm:leading-[1.05] lg:text-6xl">
          {negocio.claim}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-muted sm:mt-6 sm:text-lg">{negocio.descripcion}</p>
        <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap">
          <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`}>Llamar ahora</Button>
          <Button class="w-full sm:w-auto" href={negocio.googleMaps} variant="secondary" target="_blank" rel="noopener noreferrer">
            Cómo llegar
          </Button>
        </div>
        <p class="mt-5">
          <a class="text-sm font-bold text-berry hover:underline" href="/productos/">Ver productos →</a>
        </p>
        <div class="mt-7 flex flex-wrap gap-2.5 sm:mt-9">
          {
            badges.map((badge) => (
              <span class="rounded-full border border-line bg-white/70 px-3.5 py-1.5 text-xs font-semibold text-muted backdrop-blur">
                {badge}
              </span>
            ))
          }
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[220px] sm:max-w-sm">
        <div class="blob-shape relative flex aspect-square items-center justify-center bg-white p-6 shadow-xl ring-1 ring-line sm:p-10">
          <img class="h-24 w-24 sm:h-40 sm:w-40 lg:h-48 lg:w-48" src={negocio.logo} alt={negocio.nombre} width="360" height="360" />
        </div>
      </div>
    </div>
  </section>

  <Section
    eyebrow="Cada día en el puesto"
    title="Color, frescura y producto de mercado"
    description="Fruta y verdura seleccionadas cada jornada, con disponibilidad variable según mercado y temporada."
  >
    <div class="grid gap-5 sm:grid-cols-2">
      <GalleryCard src={imagenFruta.src} alt={imagenFruta.alt} titulo={imagenFruta.titulo} caption={imagenFruta.caption} headingLevel="h3" />
      <GalleryCard src={imagenVerdura.src} alt={imagenVerdura.alt} titulo={imagenVerdura.titulo} caption={imagenVerdura.caption} headingLevel="h3" />
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Producto fresco"
    title="Lo que encontrarás en nuestro puesto"
    description="Categorías con selección diaria de mercado. La disponibilidad concreta depende de la temporada; consúltala en tienda."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {categorias.map((categoria) => <CategoryCard {...categoria} />)}
    </div>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href="/productos/" variant="secondary">Ver catálogo completo</Button>
      <Button class="w-full sm:w-auto" href="/temporada/" variant="secondary">Ver temporada</Button>
    </div>
  </Section>

  <Section tone="lilac" eyebrow="Quiénes somos" title="Comercio de barrio, trato de mercado">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="m-0 text-base leading-relaxed text-ink/80">{negocio.sobreNosotros.texto}</p>
        <ul class="m-0 mt-6 grid gap-3 p-0 text-base text-ink/80">
          <li class="flex list-none items-start gap-3">
            <span class="text-xl" aria-hidden="true">🤝</span>
            <span>Atención cercana en cada visita al puesto.</span>
          </li>
          <li class="flex list-none items-start gap-3">
            <span class="text-xl" aria-hidden="true">🧺</span>
            <span>Selección diaria pensada para tu cocina.</span>
          </li>
          <li class="flex list-none items-start gap-3">
            <span class="text-xl" aria-hidden="true">🏘️</span>
            <span>La confianza de comprar en tu mercado de barrio.</span>
          </li>
        </ul>
        <div class="mt-7">
          <Button href="/contacto/" variant="secondary">Visítanos en el mercado</Button>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xs">
        <Blob class="-z-10 -right-6 -bottom-6 h-32 w-32 bg-berry/20" />
        <GalleryCard src={imagenPuesto.src} alt={imagenPuesto.alt} titulo={imagenPuesto.titulo} caption={imagenPuesto.caption} headingLevel="h3" />
      </div>
    </div>
  </Section>

  <Section
    eyebrow="Nuestro puesto"
    title="Así es el día a día en Frutería Salud"
    description="Preparación, atención y trato cercano dentro del Mercado de Abastos Tiro de Línea."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <GalleryCard src={imagenPuesto.src} alt={imagenPuesto.alt} titulo={imagenPuesto.titulo} caption={imagenPuesto.caption} headingLevel="h3" />
      <GalleryCard src={imagenPedidos.src} alt={imagenPedidos.alt} titulo={imagenPedidos.titulo} caption={imagenPedidos.caption} headingLevel="h3" />
      <GalleryCard src={imagenEquipo.src} alt={imagenEquipo.alt} titulo={imagenEquipo.titulo} caption={imagenEquipo.caption} headingLevel="h3" />
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Ubicación"
    title="Visítanos en el Mercado de Abastos Tiro de Línea"
    description="Estamos en pleno barrio de Tiro de Línea, en el corazón del mercado de abastos."
  >
    <LocationCard showCallButton />
  </Section>

  <Section
    tone="lilac"
    eyebrow="Empresa y reparto"
    title="Hay una estructura real detrás del puesto"
    description="Somos un negocio familiar organizado en tres puestos del mercado, con capacidad para atender pedidos de clientes habituales y de negocios. Conoce cómo trabajamos, cómo preparamos los encargos y qué sabemos hoy sobre reparto."
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href="/empresa/">Conoce la empresa</Button>
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`} variant="secondary">Llamar ahora</Button>
    </div>
  </Section>

  <Section
    tone="green"
    eyebrow="Encargos"
    title="¿Necesitas encargar producto?"
    description={`Resolvemos encargos según disponibilidad. Llámanos al ${negocio.contacto.telefono} o pásate por el puesto para confirmar tu pedido.`}
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href="/encargos/">Consultar encargos</Button>
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`} variant="secondary">Llamar ahora</Button>
    </div>
  </Section>

  <Section>
    <CTABanner
      eyebrow="Te esperamos"
      title="Ven a conocernos al mercado"
      description="Fruta y verdura fresca, seleccionada cada día en el Mercado de Abastos Tiro de Línea."
    >
      <Button class="w-full sm:w-auto" href="/contacto/" variant="secondary">Visítanos en el mercado</Button>
      <Button class="w-full sm:w-auto" href="/empresa/" variant="ghost-light">Empresa y reparto</Button>
      <Button class="w-full sm:w-auto" href={negocio.facebook} variant="ghost-light" target="_blank" rel="noopener noreferrer">
        Síguenos en Facebook
      </Button>
    </CTABanner>
  </Section>
</Layout>
