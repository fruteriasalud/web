---
import Blob from '../components/Blob.astro';
import Button from '../components/Button.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CTABanner from '../components/CTABanner.astro';
import GalleryCard from '../components/GalleryCard.astro';
import LocationCard from '../components/LocationCard.astro';
import Section from '../components/Section.astro';
import { categorias } from '../data/categorias';
import { galeria } from '../data/galeria';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';
import { createLocalBusinessJsonLd } from '../lib/seo';

const badges = ['🌅 Cambia cada mañana', '📍 Puestos 47, 48 y 49', '📞 Llama y te decimos qué hay'];

const imagenPuesto = galeria.find((item) => item.id === 'puesto-mercado')!;
---

<Layout
  title={negocio.seo.defaultTitle}
  description={negocio.seo.defaultDescription}
  canonical="/"
  jsonLd={createLocalBusinessJsonLd()}
>
  <section class="relative overflow-hidden px-5 pt-8 pb-10 sm:pt-16 sm:pb-24">
    <Blob class="-top-24 -left-20 h-72 w-72 bg-berry/20" />
    <Blob class="top-16 -right-24 h-80 w-80 bg-leaf/15" />
    <Blob class="bottom-0 left-1/3 h-56 w-56 bg-lilac-deep/15" />

    <div class="relative mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-12">
      <div>
        <p class="m-0 inline-block rounded-full border border-line bg-white/70 px-4 py-1.5 text-sm font-bold text-leaf backdrop-blur">
          Mercado de Abastos Tiro de Línea · Sevilla
        </p>
        <h1 class="m-0 mt-4 text-3xl font-black leading-[1.1] text-ink sm:mt-5 sm:text-5xl sm:leading-[1.05] lg:text-6xl">
          {negocio.claim}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-muted sm:mt-6 sm:text-lg">
          Estamos dentro del Mercado de Abastos Tiro de Línea. Llámanos o ven al puesto y te decimos qué hay mejor hoy.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap">
          <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`}>Llamar ahora</Button>
          <Button class="w-full sm:w-auto" href={negocio.googleMaps} variant="secondary" target="_blank" rel="noopener noreferrer">
            Cómo llegar
          </Button>
        </div>
        <p class="mt-5">
          <a class="text-sm font-bold text-berry hover:underline" href="/productos/">Ver productos →</a>
        </p>
        <div class="mt-7 flex flex-wrap gap-2.5 sm:mt-9">
          {
            badges.map((badge) => (
              <span class="rounded-full border border-line bg-white/70 px-3.5 py-1.5 text-xs font-semibold text-muted backdrop-blur">
                {badge}
              </span>
            ))
          }
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[240px] pb-4 sm:max-w-sm">
        <div class="blob-shape bg-dot-grid relative flex aspect-square items-center justify-center overflow-hidden bg-leaf-soft shadow-xl ring-1 ring-line">
          <div class="absolute inset-0 bg-gradient-to-br from-leaf-soft via-leaf-soft/40 to-transparent"></div>
          <div class="relative flex flex-col items-center gap-3">
            <span class="text-5xl sm:text-6xl" aria-hidden="true">🍊</span>
            <img class="h-12 w-12 opacity-80 sm:h-14 sm:w-14" src={negocio.logo} alt={negocio.nombre} width="120" height="120" />
          </div>
        </div>
        <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-white px-4 py-1.5 text-xs font-bold text-muted shadow-sm ring-1 ring-line">
          Foto real del puesto, próximamente
        </span>
      </div>
    </div>
  </section>

  <Section
    tone="paper"
    eyebrow="Producto fresco"
    title="Lo que encontrarás en nuestro puesto"
    description="Cada mañana cambia el género. Ven al puesto y te recomendamos lo que esté mejor ese día."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {categorias.map((categoria) => <CategoryCard {...categoria} />)}
    </div>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href="/productos/" variant="secondary">Ver catálogo completo</Button>
      <Button class="w-full sm:w-auto" href="/temporada/" variant="secondary">Ver temporada</Button>
    </div>
  </Section>

  <Section tone="lilac" eyebrow="Quiénes somos" title="Frutería familiar en el mercado">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="m-0 text-base leading-relaxed text-ink/80">{negocio.sobreNosotros.texto}</p>
        <ul class="m-0 mt-6 grid gap-3 p-0 text-base text-ink/80">
          <li class="flex list-none items-start gap-3">
            <span class="text-xl" aria-hidden="true">📍</span>
            <span>Estamos en los puestos 47, 48 y 49.</span>
          </li>
          <li class="flex list-none items-start gap-3">
            <span class="text-xl" aria-hidden="true">🌅</span>
            <span>Cada mañana cambia el género.</span>
          </li>
          <li class="flex list-none items-start gap-3">
            <span class="text-xl" aria-hidden="true">📞</span>
            <span>Si buscas algo concreto, llámanos antes.</span>
          </li>
        </ul>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href="/contacto/" variant="secondary">Visítanos en el mercado</Button>
          <a class="text-sm font-bold text-berry hover:underline" href="/empresa/">Cómo trabajamos →</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xs">
        <Blob class="-z-10 -right-6 -bottom-6 h-32 w-32 bg-berry/20" />
        <GalleryCard src={imagenPuesto.src} alt={imagenPuesto.alt} titulo={imagenPuesto.titulo} caption={imagenPuesto.caption} headingLevel="h3" />
      </div>
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Ubicación"
    title="Visítanos en el Mercado de Abastos Tiro de Línea"
    description="Estamos en pleno barrio de Tiro de Línea, en el corazón del mercado de abastos."
  >
    <LocationCard showCallButton />
  </Section>

  <Section
    tone="green"
    eyebrow="Encargos"
    title="¿Necesitas encargar producto?"
    description={`Llámanos antes al ${negocio.contacto.telefono} y te decimos si lo tenemos, o pásate directamente por el puesto.`}
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href="/encargos/">Consultar encargos</Button>
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`} variant="secondary">Llamar ahora</Button>
    </div>
  </Section>

  <Section>
    <CTABanner
      eyebrow="Te esperamos"
      title="Ven a conocernos al mercado"
      description="Puestos 47, 48 y 49, dentro del Mercado de Abastos Tiro de Línea."
    >
      <Button class="w-full sm:w-auto" href="/contacto/" variant="secondary">Visítanos en el mercado</Button>
      <Button class="w-full sm:w-auto" href="/empresa/" variant="ghost-light">Quiénes somos</Button>
    </CTABanner>
  </Section>
</Layout>
