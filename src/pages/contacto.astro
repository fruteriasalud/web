---
import Button from '../components/Button.astro';
import BusinessInfo from '../components/BusinessInfo.astro';
import CTABanner from '../components/CTABanner.astro';
import LocationCard from '../components/LocationCard.astro';
import Section from '../components/Section.astro';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto y ubicación"
  description="Llama, escríbenos por Facebook o visítanos en el Mercado de Abastos Tiro de Línea, puestos 47, 48 y 49, Sevilla."
  canonical="/contacto/"
>
  <Section
    eyebrow="Contacto"
    title="Estamos en el Mercado de Abastos Tiro de Línea"
    description={negocio.direccion.texto}
    headingLevel="h1"
  >
    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <LocationCard headingLevel="h2" />
      <BusinessInfo />
    </div>
  </Section>

  <Section tone="paper">
    <CTABanner
      eyebrow="Habla con nosotros"
      title="¿Tienes alguna duda o quieres encargar producto?"
      description={`Llámanos al ${negocio.contacto.telefono} y consulta disponibilidad, o pásate directamente por el puesto: te atendemos encantados.`}
    >
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`} variant="secondary">Llamar ahora</Button>
      <Button class="w-full sm:w-auto" href="/encargos/" variant="secondary">Consultar encargos</Button>
    </CTABanner>
  </Section>
</Layout>
