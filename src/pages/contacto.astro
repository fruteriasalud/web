---
import BusinessInfo from '../components/BusinessInfo.astro';
import Section from '../components/Section.astro';
import { contacto } from '../data/contacto';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto y ubicación"
  description="Ubicación de Frutería Salud en el Mercado de Abastos Tiro de Línea, puestos 47, 48 y 49, Sevilla."
  canonical="/contacto/"
>
  <Section
    eyebrow="Contacto"
    title="Estamos en el Mercado de Abastos Tiro de Línea"
    description={negocio.direccion.texto}
  >
    <BusinessInfo />
  </Section>

  <Section tone="paper" title="Datos pendientes de confirmar">
    <ul class="m-0 grid gap-2 p-0 text-[var(--color-muted)]">
      {contacto.pendientes.map((item) => <li class="list-none rounded-lg border border-[var(--color-line)] bg-white p-4">{item}</li>)}
    </ul>
  </Section>
</Layout>
