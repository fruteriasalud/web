---
import BusinessInfo from '../components/BusinessInfo.astro';
import LocationCard from '../components/LocationCard.astro';
import Section from '../components/Section.astro';
import { contacto } from '../data/contacto';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto y ubicación"
  description="Ubicación de Frutería Salud en el Mercado de Abastos Tiro de Línea, puestos 47, 48 y 49, Sevilla."
  canonical="/contacto/"
>
  <Section
    eyebrow="Contacto"
    title="Estamos en el Mercado de Abastos Tiro de Línea"
    description={negocio.direccion.texto}
  >
    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <LocationCard />
      <BusinessInfo />
    </div>
  </Section>

  {
    contacto.pendientes.length > 0 && (
      <Section tone="lilac" title="Datos pendientes de confirmar">
        <ul class="m-0 grid gap-3 p-0 sm:grid-cols-2">
          {contacto.pendientes.map((item) => (
            <li class="list-none rounded-2xl border border-line bg-white/70 p-4 text-sm font-semibold text-ink">{item}</li>
          ))}
        </ul>
      </Section>
    )
  }
</Layout>
