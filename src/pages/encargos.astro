---
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';

const pasos = [
  {
    numero: '1',
    icono: '💬',
    titulo: 'Canal de pedido',
    texto: 'Pendiente de confirmar teléfono, WhatsApp, email u otro canal oficial.',
  },
  {
    numero: '2',
    icono: '🗓️',
    titulo: 'Disponibilidad',
    texto: 'La disponibilidad de producto debe confirmarse según temporada y mercado.',
  },
  {
    numero: '3',
    icono: '🧺',
    titulo: 'Recogida',
    texto: 'Información pendiente de confirmar en los puestos 47, 48 y 49.',
  },
];
---

<Layout
  title="Encargos"
  description="Información base sobre encargos en Frutería Salud. Condiciones, canales y disponibilidad pendientes de confirmar."
  canonical="/encargos/"
>
  <Section
    eyebrow="Encargos"
    title="Compra preparada con información prudente"
    description="Esta página queda lista para explicar el proceso cuando la frutería confirme canales, horarios, cantidades y condiciones."
  >
    <div class="grid gap-5 md:grid-cols-3">
      {
        pasos.map((paso) => (
          <article class="relative rounded-2xl border border-line bg-white p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-berry-soft text-sm font-black text-berry-dark">
                {paso.numero}
              </span>
              <span class="text-2xl" aria-hidden="true">
                {paso.icono}
              </span>
            </div>
            <h2 class="m-0 mt-4 text-lg font-black text-ink">{paso.titulo}</h2>
            <p class="mb-0 mt-2 text-sm leading-relaxed text-muted">{paso.texto}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={negocio.facebook}>Consultar por Facebook</Button>
      <Button href="/contacto/" variant="secondary">Cómo llegar</Button>
    </div>
  </Section>

  <Section tone="lilac" title="Encargos sujetos a disponibilidad">
    <p class="m-0 max-w-3xl text-ink/80">
      Todos los encargos dependen del producto disponible cada día en el mercado. Consulta cantidades, plazos y condiciones directamente en el puesto antes de confirmar tu pedido.
    </p>
  </Section>
</Layout>
