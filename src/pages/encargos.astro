---
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';

const pasos = [
  {
    numero: '1',
    icono: '🍏',
    titulo: 'Elige o consulta producto',
    texto: 'Piensa qué necesitas: fruta, verdura o algo concreto de temporada.',
  },
  {
    numero: '2',
    icono: '📞',
    titulo: 'Llama o visita el puesto',
    texto: 'Cuéntanos tu encargo por teléfono o directamente en los puestos 47, 48 y 49.',
  },
  {
    numero: '3',
    icono: '✅',
    titulo: 'Confirmamos disponibilidad',
    texto: 'Te decimos si tenemos el producto y en qué cantidad según el día.',
  },
  {
    numero: '4',
    icono: '🧺',
    titulo: 'Recoge en el mercado',
    texto: 'Pasas a recoger tu encargo cuando te venga bien en el Mercado de Abastos Tiro de Línea.',
  },
];
---

<Layout
  title="Encargos"
  description="Cómo hacer un encargo en Frutería Salud: consulta por teléfono o en el puesto, confirmamos disponibilidad y recoges en el mercado."
  canonical="/encargos/"
>
  <Section
    eyebrow="Encargos"
    title="Encarga tu producto en cuatro pasos"
    description="Resolvemos los encargos por teléfono o en el propio puesto, según el producto disponible cada día."
    headingLevel="h1"
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        pasos.map((paso) => (
          <article class="relative flex flex-col rounded-2xl border border-line bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-card-hover">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-berry-soft text-sm font-black text-berry-dark">
                {paso.numero}
              </span>
              <span class="text-2xl" aria-hidden="true">
                {paso.icono}
              </span>
            </div>
            <h2 class="m-0 mt-4 text-lg font-black text-ink">{paso.titulo}</h2>
            <p class="mb-0 mt-2 text-sm leading-relaxed text-muted">{paso.texto}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`}>Llamar ahora</Button>
      <Button class="w-full sm:w-auto" href="/contacto/" variant="secondary">Cómo llegar</Button>
      <Button class="w-full sm:w-auto" href={negocio.facebook} variant="secondary" target="_blank" rel="noopener noreferrer">
        Escríbenos por Facebook
      </Button>
    </div>
  </Section>

  <Section tone="lilac" title="Encargos sujetos a disponibilidad">
    <p class="m-0 max-w-3xl text-ink/80">
      Todos los encargos dependen del producto disponible cada día en el mercado. Llámanos al{' '}
      <a class="font-bold text-berry-dark underline" href={`tel:${negocio.contacto.telefonoTel}`}>
        {negocio.contacto.telefono}
      </a>{' '}
      para confirmar cantidades, plazos y condiciones antes de tu visita.
    </p>
  </Section>
</Layout>
