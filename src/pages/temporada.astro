---
import Button from '../components/Button.astro';
import CatalogCard from '../components/CatalogCard.astro';
import CTABanner from '../components/CTABanner.astro';
import Section from '../components/Section.astro';
import { catalogo } from '../data/catalogo';
import { negocio } from '../data/negocio';
import { temporadas } from '../data/temporada';
import Layout from '../layouts/Layout.astro';

const tonos = ['paper', 'green', 'lilac', 'default'] as const;

function productosDeTemporada(ids: readonly string[]) {
  return ids
    .map((id) => catalogo.find((producto) => producto.id === id))
    .filter((producto): producto is (typeof catalogo)[number] => Boolean(producto));
}
---

<Layout
  title="Temporada"
  description="Producto fresco de temporada en Frutas y Verduras Salud. La disponibilidad se confirma en tienda según mercado y época del año."
  canonical="/temporada/"
>
  <Section
    eyebrow="Temporada"
    title="Producto que cambia con el mercado"
    description="Trabajamos con lo que ofrece cada época del año. La disponibilidad puede variar según mercado; te la confirmamos en el puesto."
    headingLevel="h1"
  >
  </Section>

  <Section>
    <CTABanner
      eyebrow="Encargos"
      title="¿Necesitas reservar producto de temporada?"
      description="Los encargos quedan sujetos a disponibilidad. Podemos confirmarte cantidades y plazos por teléfono."
    >
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`} variant="secondary">Llamar ahora</Button>
      <Button class="w-full sm:w-auto" href="/encargos/" variant="secondary">Ver encargos</Button>
    </CTABanner>
  </Section>

  {
    temporadas.map((temporada, index) => (
      <Section tone={tonos[index % tonos.length]} eyebrow={temporada.nombre} title={`${temporada.icono} Producto de ${temporada.nombre.toLowerCase()}`} description={temporada.texto}>
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {productosDeTemporada(temporada.productos).map((producto) => (
            <CatalogCard {...producto} />
          ))}
        </div>
      </Section>
    ))
  }
</Layout>
