---
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';

const inputClass =
  'mt-2 min-h-12 w-full rounded-[var(--radius-button)] border border-line bg-white px-4 py-3 text-base text-ink shadow-sm transition-colors placeholder:text-muted/65 hover:border-berry/40 focus:border-berry focus:outline-none';
const labelClass = 'block text-sm font-bold text-ink';
const emailSubject = encodeURIComponent('Candidatura para trabajar en Frutería Salud');
---

<Layout
  title="Trabaja con nosotros"
  description="Envía tu candidatura para trabajar en Frutas y Verduras Salud, frutería familiar del Mercado de Abastos Tiro de Línea en Sevilla."
  canonical="/trabaja-con-nosotros/"
>
  <Section
    eyebrow="Forma parte del equipo"
    title="Trabaja con nosotros"
    description="¿Te gustaría formar parte de Frutería Salud?"
    headingLevel="h1"
  >
    <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
      <div class="grid gap-6 text-base leading-relaxed text-muted">
        <p class="m-0">
          Somos una frutería familiar situada en el Mercado de Abastos Tiro de Línea, en Sevilla. Cada día trabajamos
          con producto fresco, trato cercano y atención directa a nuestros clientes.
        </p>
        <p class="m-0">
          Si tienes experiencia en frutería, atención al público, preparación de pedidos, reparto o simplemente ganas
          de trabajar y aprender, puedes enviarnos tu candidatura desde esta página.
        </p>
      </div>

      <div class="rounded-[var(--radius-panel)] border border-line bg-paper p-5 shadow-[var(--shadow-card)] sm:p-8">
        <form
          id="candidatura-form"
          class="grid gap-5"
          action="/api/trabaja-con-nosotros"
          method="post"
          enctype="multipart/form-data"
        >
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">No rellenes este campo</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <label class={labelClass} for="nombre">Nombre y apellidos</label>
            <input class={inputClass} id="nombre" name="nombre" type="text" autocomplete="name" required />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class={labelClass} for="telefono">Teléfono</label>
              <input class={inputClass} id="telefono" name="telefono" type="tel" autocomplete="tel" required />
            </div>
            <div>
              <label class={labelClass} for="email">Email</label>
              <input class={inputClass} id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div>
            <label class={labelClass} for="puesto">Puesto que te interesa</label>
            <select class={inputClass} id="puesto" name="puesto" required>
              <option value="">Selecciona una opción</option>
              <option>Atención al público</option>
              <option>Frutería</option>
              <option>Preparación de pedidos</option>
              <option>Reparto</option>
              <option>Otro</option>
            </select>
          </div>

          <div>
            <label class={labelClass} for="experiencia">Cuéntanos brevemente tu experiencia</label>
            <textarea
              class:list={[inputClass, 'min-h-36 resize-y']}
              id="experiencia"
              name="experiencia"
              rows="5"
              required
            ></textarea>
          </div>

          <div>
            <label class={labelClass} for="curriculum">Adjuntar currículum</label>
            <input
              class:list={[inputClass, 'cursor-pointer file:mr-3 file:rounded-[var(--radius-chip)] file:border-0 file:bg-berry-soft file:px-3 file:py-2 file:text-sm file:font-bold file:text-berry-dark']}
              id="curriculum"
              name="curriculum"
              type="file"
              accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              required
            />
            <p class="m-0 mt-2 text-xs leading-relaxed text-muted">
              Formatos admitidos: PDF, DOC y DOCX. Tamaño máximo: 5 MB.
            </p>
          </div>

          <label class="flex cursor-pointer items-start gap-3 rounded-[var(--radius-card)] border border-line bg-white p-4 text-sm leading-relaxed text-muted">
            <input
              class="mt-1 h-5 w-5 shrink-0 accent-berry"
              id="privacidad"
              name="privacidad"
              type="checkbox"
              required
            />
            <span>
              Acepto que Frutería Salud trate mis datos personales y el currículum adjunto con la finalidad de valorar
              mi candidatura para posibles procesos de selección. He leído y acepto la
              <a class="font-bold text-berry hover:underline" href="/privacidad/">política de privacidad</a>.
            </span>
          </label>

          <div>
            <button
              class="btn-primary inline-flex min-h-12 w-full cursor-pointer items-center justify-center px-5 py-3 text-base font-bold transition-colors sm:w-auto"
              type="submit"
            >
              Enviar candidatura
            </button>
            <p id="form-status" class="m-0 mt-3 text-sm leading-relaxed text-muted" role="status" aria-live="polite">
              Los campos marcados son obligatorios.
            </p>
          </div>
        </form>

        <p class="m-0 mt-6 border-t border-line pt-5 text-sm font-semibold leading-relaxed text-leaf-dark">
          Usaremos tus datos únicamente para valorar tu candidatura. No los utilizaremos para otros fines.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="green" eyebrow="Contacto directo" title="También puedes contactar con nosotros directamente">
    <p class="m-0 max-w-2xl text-base leading-relaxed text-ink/75">
      Si prefieres hablar con la frutería, llámanos o escríbenos por correo electrónico.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`}>
        Llamar al {negocio.contacto.telefono}
      </Button>
      {
        negocio.contacto.whatsapp && (
          <Button class="w-full sm:w-auto" href={`https://wa.me/${negocio.contacto.whatsapp}`} variant="secondary">
            WhatsApp
          </Button>
        )
      }
      {
        negocio.contacto.email && (
          <Button
            class="w-full sm:w-auto"
            href={`mailto:${negocio.contacto.email}?subject=${emailSubject}`}
            variant="secondary"
          >
            Enviar email
          </Button>
        )
      }
    </div>
  </Section>
</Layout>

<script>
  const form = document.querySelector('#candidatura-form');
  const status = document.querySelector('#form-status');
  const submitButton = form?.querySelector('button[type="submit"]');
  const curriculumInput = form?.querySelector('#curriculum');
  const maxCvSize = 5 * 1024 * 1024;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

    const curriculum =
      curriculumInput instanceof HTMLInputElement && curriculumInput.files ? curriculumInput.files[0] : undefined;

    if (!curriculum) {
      if (status) status.textContent = 'Adjunta tu currículum.';
      return;
    }

    if (curriculum.size > maxCvSize) {
      if (status) {
        status.className = 'm-0 mt-3 text-sm font-semibold leading-relaxed text-berry';
        status.textContent = 'El currículum no puede superar los 5 MB.';
      }
      curriculumInput.setCustomValidity('El currículum no puede superar los 5 MB.');
      curriculumInput.reportValidity();
      return;
    }

    curriculumInput.setCustomValidity('');
    form.setAttribute('aria-busy', 'true');
    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.textContent = 'Enviando...';
      submitButton.classList.add('cursor-wait', 'opacity-70');
    }
    if (status) {
      status.className = 'm-0 mt-3 text-sm leading-relaxed text-muted';
      status.textContent = 'Enviando tu candidatura...';
    }

    try {
      const response = await fetch('/api/trabaja-con-nosotros', {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = await response.json().catch(() => null);

      if (!response.ok || !result?.ok) {
        throw new Error(result?.error || 'No se ha podido enviar la candidatura.');
      }

      form.reset();
      if (status) {
        status.className = 'm-0 mt-3 text-sm font-semibold leading-relaxed text-leaf';
        status.textContent = 'Candidatura enviada correctamente. Gracias por contactar con Frutería Salud.';
      }
    } catch {
      if (status) {
        status.className = 'm-0 mt-3 text-sm font-semibold leading-relaxed text-berry';
        status.textContent =
          'No hemos podido enviar tu candidatura. Inténtalo de nuevo o contacta por teléfono o email.';
      }
    } finally {
      form.removeAttribute('aria-busy');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.textContent = 'Enviar candidatura';
        submitButton.classList.remove('cursor-wait', 'opacity-70');
      }
    }
  });

  curriculumInput?.addEventListener('change', () => {
    if (curriculumInput instanceof HTMLInputElement) curriculumInput.setCustomValidity('');
  });
</script>
