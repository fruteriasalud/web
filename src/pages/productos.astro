---
import Button from '../components/Button.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CTABanner from '../components/CTABanner.astro';
import ProductCard from '../components/ProductCard.astro';
import Section from '../components/Section.astro';
import { categorias } from '../data/categorias';
import { productos } from '../data/productos';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Productos"
  description="Frutas, verduras y producto fresco de temporada en Frutería Salud, Mercado de Abastos Tiro de Línea de Sevilla."
  canonical="/productos/"
>
  <Section
    eyebrow="Productos"
    title="Fruta, verdura y producto fresco"
    description="Categorías con selección diaria de mercado. La disponibilidad concreta depende de la temporada y se confirma en tienda."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {categorias.map((categoria) => <CategoryCard {...categoria} />)}
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Selección inicial"
    title="Producto de mercado"
    description="Listado base preparado para ampliarse con productos concretos cuando estén confirmados por la frutería."
  >
    <div class="grid gap-4 md:grid-cols-2">
      {productos.map((producto) => <ProductCard {...producto} />)}
    </div>
  </Section>

  <Section>
    <CTABanner
      eyebrow="¿Buscas algo concreto?"
      title="Consulta disponibilidad en tienda"
      description="La selección exacta cambia según el día y la temporada."
    >
      <Button href="/temporada/" variant="secondary">Ver temporada</Button>
      <Button href="/contacto/" variant="ghost-light">Cómo llegar</Button>
    </CTABanner>
  </Section>
</Layout>
