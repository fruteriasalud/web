---
import Button from '../components/Button.astro';
import CatalogCard from '../components/CatalogCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CTABanner from '../components/CTABanner.astro';
import Section from '../components/Section.astro';
import { catalogo } from '../data/catalogo';
import { categorias } from '../data/categorias';
import { negocio } from '../data/negocio';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Productos"
  description="Frutas, verduras y producto fresco de temporada en Frutas y Verduras Salud, Mercado de Abastos Tiro de Línea de Sevilla."
  canonical="/productos/"
>
  <Section
    eyebrow="Productos"
    title="Fruta, verdura y producto fresco"
    description="Así organizamos el puesto cada día. La disponibilidad concreta depende de la temporada y se confirma en tienda."
    headingLevel="h1"
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {categorias.map((categoria) => <CategoryCard {...categoria} headingLevel="h2" />)}
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Catálogo habitual"
    title="Lo que sueles encontrar en nuestro puesto"
    description="Una muestra de los productos más habituales. Los productos pueden variar según temporada y mercado."
  >
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {catalogo.map((producto) => <CatalogCard {...producto} />)}
    </div>
  </Section>

  <Section tone="paper" eyebrow="Más producto" title="¿Buscas algo más?" description="Además de fruta y verdura, también podemos ayudarte con esto.">
    <div class="grid gap-5 sm:grid-cols-2">
      <article class="flex flex-col rounded-[var(--radius-card)] border border-line bg-white p-6 shadow-[var(--shadow-card)]">
        <span class="mb-3 flex h-12 w-12 items-center justify-center rounded-[var(--radius-chip)] bg-berry-soft text-2xl" aria-hidden="true">
          🌰
        </span>
        <h3 class="m-0 text-lg font-black text-ink">Frutos secos</h3>
        <p class="mb-0 mt-2 text-sm leading-relaxed text-muted">
          También ponemos a tu disposición una amplia variedad de frutos secos. Consúltanos y te ayudaremos a encontrar
          la opción que necesitas.
        </p>
      </article>

      <article class="flex flex-col rounded-[var(--radius-card)] border border-line bg-white p-6 shadow-[var(--shadow-card)]">
        <span class="mb-3 flex h-12 w-12 items-center justify-center rounded-[var(--radius-chip)] bg-leaf-soft text-2xl" aria-hidden="true">
          🌿
        </span>
        <h3 class="m-0 text-lg font-black text-ink">Otros productos</h3>
        <p class="mb-0 mt-2 text-sm leading-relaxed text-muted">
          ¿Buscas algo diferente? También trabajamos con delicatessen, brotes, flores comestibles, micromesclun, dátiles
          y otros productos especiales. Cuéntanos qué necesitas y consultaremos su disponibilidad para ayudarte a
          conseguirlo.
        </p>
      </article>
    </div>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`}>Consúltanos por teléfono</Button>
      <Button class="w-full sm:w-auto" href="/contacto/" variant="secondary">Ir a contacto</Button>
    </div>
  </Section>

  <Section>
    <CTABanner
      eyebrow="¿Buscas algo concreto?"
      title="Consulta disponibilidad en tienda"
      description="La selección exacta cambia según el día y la temporada. Podemos confirmártelo por teléfono."
    >
      <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`} variant="secondary">Llamar ahora</Button>
      <Button class="w-full sm:w-auto" href="/temporada/" variant="secondary">Ver temporada</Button>
      <Button class="w-full sm:w-auto" href="/contacto/" variant="ghost-light">Cómo llegar</Button>
    </CTABanner>
  </Section>
</Layout>
