---
import Section from '../components/Section.astro';
import Layout from './Layout.astro';
import type { SeoProps } from '../lib/seo';

type Props = SeoProps & {
  title: string;
  actualizado: string;
};

const { title, actualizado, ...seo } = Astro.props as Props;
---

<Layout title={title} {...seo}>
  <Section eyebrow="Información legal" title={title} headingLevel="h1">
    <div class="max-w-3xl space-y-6 text-sm leading-relaxed text-muted">
      <slot />
    </div>
    <p class="mt-10 max-w-3xl border-t border-line pt-5 text-xs text-muted">Última actualización: {actualizado}</p>
  </Section>
</Layout>
