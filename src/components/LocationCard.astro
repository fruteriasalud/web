---
import Button from './Button.astro';
import { negocio } from '../data/negocio';

type Props = {
  showCallButton?: boolean;
  headingLevel?: 'h2' | 'h3';
};

const { showCallButton = false, headingLevel = 'h3' } = Astro.props as Props;
const HeadingTag = headingLevel;
---

<div class="grid gap-0 overflow-hidden rounded-3xl border border-line bg-white shadow-sm md:grid-cols-2">
  <div class="relative flex min-h-56 items-center justify-center bg-leaf-soft bg-dot-grid p-8">
    <div class="absolute inset-0 bg-gradient-to-br from-leaf-soft via-leaf-soft/40 to-transparent"></div>
    <div class="relative flex h-16 w-16 items-center justify-center rounded-full bg-berry text-2xl text-white shadow-lg" aria-hidden="true">
      📍
    </div>
  </div>

  <div class="p-6 sm:p-8">
    <p class="m-0 text-sm font-bold uppercase tracking-wide text-leaf">Mercado de Abastos Tiro de Línea</p>
    <HeadingTag class="m-0 mt-2 text-xl font-black text-ink">Puestos {negocio.direccion.puestos}</HeadingTag>
    <p class="mt-3 mb-0 text-sm leading-relaxed text-muted">{negocio.direccion.texto}</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <Button class="w-full sm:w-auto" href={negocio.googleMaps} target="_blank" rel="noopener noreferrer">Cómo llegar</Button>
      {showCallButton && <Button class="w-full sm:w-auto" href={`tel:${negocio.contacto.telefonoTel}`} variant="secondary">Llamar ahora</Button>}
    </div>
  </div>
</div>
