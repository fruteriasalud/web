---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props as Props;
---

<div class="relative overflow-hidden rounded-3xl bg-berry px-6 py-12 text-center text-white sm:px-12 sm:py-16">
  <div class="pointer-events-none absolute -top-16 -left-16 h-56 w-56 rounded-full bg-white/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-20 -right-10 h-64 w-64 rounded-full bg-leaf/20 blur-3xl"></div>

  <div class="relative mx-auto max-w-2xl">
    {eyebrow && <p class="m-0 mb-2 text-sm font-bold uppercase tracking-wide text-white/80">{eyebrow}</p>}
    <h2 class="m-0 text-3xl font-black leading-tight sm:text-4xl">{title}</h2>
    {description && <p class="mt-4 mb-0 text-base text-white/85">{description}</p>}
    <div class="mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
      <slot />
    </div>
  </div>
</div>
