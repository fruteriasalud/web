---
type Props = {
  eyebrow?: string;
  title?: string;
  description?: string;
  tone?: 'default' | 'paper' | 'green' | 'lilac';
};

const { eyebrow, title, description, tone = 'default' } = Astro.props as Props;
const toneClass = {
  default: '',
  paper: 'bg-[var(--color-paper)]',
  green: 'bg-[var(--color-leaf-soft)]',
  lilac: 'bg-[var(--color-lilac)]',
}[tone];
---

<section class:list={['px-5 py-14 sm:py-16', toneClass]}>
  <div class="mx-auto max-w-6xl">
    {(eyebrow || title || description) && (
      <div class="mb-8 max-w-3xl">
        {eyebrow && <p class="m-0 mb-2 text-sm font-bold uppercase tracking-wide text-[var(--color-leaf)]">{eyebrow}</p>}
        {title && <h2 class="m-0 text-3xl font-black leading-tight text-[var(--color-ink)] sm:text-4xl">{title}</h2>}
        {description && <p class="mt-4 max-w-2xl text-base text-[var(--color-muted)]">{description}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
