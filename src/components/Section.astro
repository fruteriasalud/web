---
type Props = {
  eyebrow?: string;
  title?: string;
  description?: string;
  tone?: 'default' | 'paper' | 'green' | 'lilac';
  center?: boolean;
  headingLevel?: 'h1' | 'h2';
};

const { eyebrow, title, description, tone = 'default', center = false, headingLevel = 'h2' } = Astro.props as Props;
const HeadingTag = headingLevel;

const toneClass = {
  default: '',
  paper: 'bg-paper',
  green: 'bg-leaf-soft',
  lilac: 'bg-lilac',
}[tone];
---

<section class:list={['relative px-5 py-14 sm:py-20', toneClass]}>
  <div class="mx-auto max-w-6xl">
    {
      (eyebrow || title || description) && (
        <div class:list={['mb-10 max-w-3xl', center && 'mx-auto text-center']}>
          {eyebrow && <p class="m-0 mb-2 text-sm font-bold uppercase tracking-wide text-leaf">{eyebrow}</p>}
          {title && <HeadingTag class="m-0 text-3xl font-black leading-tight text-ink sm:text-4xl">{title}</HeadingTag>}
          {description && (
            <p class:list={['mt-4 max-w-2xl text-base text-muted', center && 'mx-auto']}>{description}</p>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>
