---
import { negocio } from '../data/negocio';
import { absoluteUrl, formatTitle, stringifyJsonLd, type SeoProps } from '../lib/seo';

const {
  title,
  description = negocio.seo.defaultDescription,
  canonical = Astro.url.pathname,
  image = negocio.imagenSocial,
  type = 'website',
  jsonLd,
} = Astro.props as SeoProps;

const pageTitle = formatTitle(title);
const canonicalUrl = absoluteUrl(canonical);
const imageUrl = absoluteUrl(image);
const jsonLdContent = stringifyJsonLd(jsonLd);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<title>{pageTitle}</title>

<meta property="og:locale" content="es_ES" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={negocio.nombre} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<meta name="geo.region" content="ES-SE" />
<meta name="geo.placename" content="Sevilla" />
<meta name="business:contact_data:locality" content={negocio.direccion.ciudad} />
<meta name="business:contact_data:region" content={negocio.direccion.provincia} />
<meta name="business:contact_data:postal_code" content={negocio.direccion.codigoPostal} />
<meta name="business:contact_data:country_name" content="España" />

{jsonLdContent && <script type="application/ld+json" set:html={jsonLdContent} />}
