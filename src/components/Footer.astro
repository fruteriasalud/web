---
import { negocio } from '../data/negocio';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5 no-underline" aria-label={`${negocio.nombre} - inicio`}>
        <img class="h-11 w-11" src="/logo/logo-fruteria-salud-transparente.png" alt={`Logo de ${negocio.nombre}`} width="88" height="88" loading="lazy" />
        <span class="text-lg font-black tracking-tight text-white">Frutas y Verduras Salud</span>
      </a>
      <p class="m-0 mt-4 max-w-sm text-sm leading-relaxed text-white/70">{negocio.descripcion}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a
          class="inline-flex items-center gap-2 rounded-[var(--radius-chip)] border border-white/20 px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:border-white/40 hover:bg-white/10"
          href={negocio.facebook}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-7.6h2.6l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46h1.6V4.2C16.3 4.14 15.32 4 14.2 4c-2.36 0-3.97 1.44-3.97 4.08v2.3H7.6v3h2.63V21h3.27Z"></path>
          </svg>
          Facebook
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-[var(--radius-chip)] border border-white/20 px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:border-white/40 hover:bg-white/10"
          href={negocio.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Instagram de ${negocio.nombre}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          Instagram
        </a>
      </div>
    </div>

    <div>
      <h2 class="m-0 mb-4 text-sm font-bold uppercase tracking-wide text-leaf-soft">Dónde estamos</h2>
      <p class="m-0 text-sm leading-relaxed text-white/70">{negocio.direccion.mercado}</p>
      <p class="m-0 mt-1 text-sm leading-relaxed text-white/70">Puestos {negocio.direccion.puestos}</p>
      <p class="m-0 mt-1 text-sm leading-relaxed text-white/70">{negocio.direccion.calle}, {negocio.direccion.ciudad}</p>
      <a class="mt-4 inline-block text-sm font-bold text-white no-underline hover:underline" href={negocio.googleMaps} target="_blank" rel="noopener noreferrer">
        Ver en Google Maps →
      </a>
    </div>

    <div>
      <h2 class="m-0 mb-4 text-sm font-bold uppercase tracking-wide text-leaf-soft">Contáctanos</h2>
      <ul class="m-0 grid gap-3 p-0 text-sm">
        <li class="list-none text-white/70">{negocio.nombre}</li>
        <li class="list-none text-white/70">
          {negocio.direccion.mercado}
          <br />
          Puestos {negocio.direccion.puestos}
        </li>
        <li class="list-none">
          <p class="m-0 text-xs font-bold uppercase tracking-wide text-white/50">{negocio.contacto.domicilio.titulo}</p>
          <p class="m-0 mt-1 flex flex-wrap gap-x-3 gap-y-0.5">
            {
              negocio.contacto.domicilio.telefonos.map((telefono) => (
                <a class="text-white/80 no-underline hover:text-white hover:underline" href={`tel:${telefono.tel}`}>
                  {telefono.texto}
                </a>
              ))
            }
          </p>
        </li>
        <li class="list-none">
          <p class="m-0 text-xs font-bold uppercase tracking-wide text-white/50">{negocio.contacto.hosteleria.titulo}</p>
          <p class="m-0 mt-1">
            {
              negocio.contacto.hosteleria.telefonos.map((telefono) => (
                <a class="text-white/80 no-underline hover:text-white hover:underline" href={`tel:${telefono.tel}`}>
                  {telefono.texto}
                </a>
              ))
            }
          </p>
        </li>
        <li class="list-none">
          <a class="text-white/70 no-underline hover:text-white hover:underline" href={negocio.siteUrl}>
            fruteriasalud.es
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 px-5 py-5 text-center text-xs text-white/50">
    <p class="m-0">© {year} {negocio.nombre} · Mercado de Abastos Tiro de Línea, Sevilla</p>
    <p class="m-0 mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
      <a class="text-white/50 no-underline hover:text-white hover:underline" href="/trabaja-con-nosotros/">Trabaja con nosotros</a>
      <a class="text-white/50 no-underline hover:text-white hover:underline" href="/aviso-legal/">Aviso legal</a>
      <a class="text-white/50 no-underline hover:text-white hover:underline" href="/privacidad/">Privacidad</a>
      <a class="text-white/50 no-underline hover:text-white hover:underline" href="/cookies/">Cookies</a>
    </p>
  </div>
</footer>
