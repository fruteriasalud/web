---
import { navegacionPrincipal } from '../data/navegacion';
import { negocio } from '../data/negocio';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)] bg-[var(--color-paper)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <img class="mb-4 h-12 w-auto" src={negocio.logo} alt={negocio.nombre} width="220" height="86" />
      <p class="m-0 max-w-md text-sm text-[var(--color-muted)]">{negocio.descripcion}</p>
    </div>

    <div>
      <h2 class="m-0 mb-3 text-base font-bold">Ubicación</h2>
      <p class="m-0 text-sm text-[var(--color-muted)]">{negocio.direccion.texto}</p>
      <a class="mt-3 inline-block text-sm font-semibold text-[var(--color-berry)]" href={negocio.googleMaps} rel="noopener noreferrer" target="_blank">
        Ver en Google Maps
      </a>
    </div>

    <div>
      <h2 class="m-0 mb-3 text-base font-bold">Secciones</h2>
      <ul class="m-0 grid gap-2 p-0 text-sm text-[var(--color-muted)]">
        {navegacionPrincipal.map((item) => <li class="list-none"><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--color-line)] px-5 py-4 text-center text-xs text-[var(--color-muted)]">
    © {year} {negocio.nombre}. Mercado de Abastos Tiro de Línea, Sevilla.
  </div>
</footer>
