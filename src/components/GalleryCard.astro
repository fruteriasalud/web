---
import { Image } from 'astro:assets';

type Props = {
  src: ImageMetadata;
  alt: string;
  titulo: string;
  caption?: string;
  headingLevel?: 'h2' | 'h3' | 'p';
  aspect?: string;
  objectPosition?: string;
  priority?: boolean;
};

const {
  src,
  alt,
  titulo,
  caption,
  headingLevel = 'p',
  aspect = 'aspect-[4/3]',
  objectPosition = 'center',
  priority = false,
} = Astro.props as Props;
const HeadingTag = headingLevel;
---

<figure class="group m-0 flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-white shadow-[var(--shadow-card)] transition-colors duration-200 hover:border-berry/35 hover:shadow-[var(--shadow-card-hover)]">
  <div class:list={['relative overflow-hidden bg-cream', aspect]}>
    <Image
      class="h-full w-full object-cover"
      style={`object-position: ${objectPosition}`}
      src={src}
      alt={alt}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  <figcaption class="p-5">
    <HeadingTag class="m-0 text-sm font-black text-ink">{titulo}</HeadingTag>
    {caption && <p class="m-0 mt-1.5 text-xs leading-relaxed text-muted">{caption}</p>}
  </figcaption>
</figure>
