---
type Props = {
  src: string;
  alt: string;
  titulo: string;
  caption?: string;
  provisional?: boolean;
  headingLevel?: 'h2' | 'h3' | 'p';
};

const { src, alt, titulo, caption, provisional = false, headingLevel = 'p' } = Astro.props as Props;
const HeadingTag = headingLevel;
---

<figure class="group m-0 flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-white shadow-[var(--shadow-card)] transition-colors duration-200 hover:border-berry/35 hover:shadow-[var(--shadow-card-hover)]">
  <div class="relative aspect-[4/3] overflow-hidden bg-cream">
    <img class="h-full w-full object-cover" src={src} alt={alt} width="800" height="600" loading="lazy" />
    {
      provisional && (
        <span class="absolute top-3 right-3 rounded-[var(--radius-chip)] bg-white/95 px-3 py-1 text-[11px] font-bold text-muted shadow-[var(--shadow-button)]">
          Imagen provisional
        </span>
      )
    }
  </div>
  <figcaption class="p-5">
    <HeadingTag class="m-0 text-sm font-black text-ink">{titulo}</HeadingTag>
    {caption && <p class="m-0 mt-1.5 text-xs leading-relaxed text-muted">{caption}</p>}
  </figcaption>
</figure>
