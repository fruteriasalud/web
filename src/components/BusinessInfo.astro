---
import { contacto } from '../data/contacto';
import { negocio } from '../data/negocio';
---

<div class="rounded-[var(--radius-panel)] border border-line bg-white p-6 sm:p-8">
  <h2 class="m-0 mb-5 text-xl font-black text-ink">Contacto y horario</h2>

  <dl class="m-0 grid gap-4 text-sm">
    <div>
      <dt class="font-bold text-ink">Teléfono</dt>
      <dd class="m-0 mt-1">
        <a class="text-base font-bold text-berry hover:underline" href={`tel:${contacto.telefonoTel}`}>
          {contacto.telefono}
        </a>
      </dd>
    </div>

    <div>
      <dt class="font-bold text-ink">Facebook</dt>
      <dd class="m-0 mt-1">
        <a class="font-semibold text-berry hover:underline" href={contacto.facebook} target="_blank" rel="noopener noreferrer">
          {negocio.nombre} en Facebook
        </a>
      </dd>
    </div>

    <div>
      <dt class="font-bold text-ink">Horario</dt>
      <dd class="m-0 mt-1 text-muted">{contacto.horarioTexto}</dd>
    </div>
  </dl>

  <p class="mt-5 mb-0 text-xs leading-relaxed text-muted">
    ¿Prefieres escribir? Puedes contactarnos por Facebook o visitarnos directamente en el mercado.
  </p>
</div>
