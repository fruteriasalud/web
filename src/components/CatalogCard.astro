---
type Props = {
  nombre: string;
  icono: string;
  descripcion: string;
  categoria: string;
  headingLevel?: 'h2' | 'h3';
};

const { nombre, icono, descripcion, categoria, headingLevel = 'h3' } = Astro.props as Props;
const HeadingTag = headingLevel;

const acentos: Record<string, string> = {
  frutas: 'bg-berry-soft',
  verduras: 'bg-leaf-soft',
  temporada: 'bg-lilac',
};

const acento = acentos[categoria] ?? 'bg-cream';
---

<article class="group flex flex-col items-center rounded-xl border border-line bg-white p-5 text-center shadow-card transition-all duration-200 hover:-translate-y-0.5 hover:shadow-card-hover">
  <div
    class:list={['mb-3 flex h-16 w-16 items-center justify-center rounded-full text-3xl', acento]}
    aria-hidden="true"
  >
    {icono}
  </div>
  <HeadingTag class="m-0 text-base font-black text-ink">{nombre}</HeadingTag>
  <p class="mb-0 mt-1.5 text-xs leading-relaxed text-muted">{descripcion}</p>
</article>
