---
type Props = {
  nombre: string;
  icono: string;
  descripcion: string;
  categoria: string;
};

const { nombre, icono, descripcion, categoria } = Astro.props as Props;

const acentos: Record<string, string> = {
  frutas: 'bg-berry-soft',
  verduras: 'bg-leaf-soft',
  temporada: 'bg-lilac',
};

const acento = acentos[categoria] ?? 'bg-cream';
---

<article class="group flex flex-col items-center rounded-2xl border border-line bg-white p-5 text-center shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
  <div
    class:list={[
      'mb-3 flex h-16 w-16 items-center justify-center rounded-full text-3xl transition-transform duration-200 group-hover:scale-105',
      acento,
    ]}
    aria-hidden="true"
  >
    {icono}
  </div>
  <h3 class="m-0 text-base font-black text-ink">{nombre}</h3>
  <p class="mb-0 mt-1.5 text-xs leading-relaxed text-muted">{descripcion}</p>
</article>
