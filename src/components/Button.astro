---
type Props = {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost-light';
  label?: string;
  class?: string;
  [key: string]: unknown;
};

const { href, variant = 'primary', label, class: className = '', ...rest } = Astro.props as Props;

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  'ghost-light': 'btn-ghost-light',
}[variant];
---

<a
  class:list={[
    'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-bold no-underline transition duration-150',
    variantClass,
    className,
  ]}
  href={href}
  {...rest}
>
  <slot>{label}</slot>
</a>
